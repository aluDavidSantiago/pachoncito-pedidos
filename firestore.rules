rules_version = '2';

// Reglas de seguridad de Pachoncito Pedidos.
// Despliegue: firebase deploy --only firestore:rules
//
// Colecciones:
//   admins/{uid}            Alta manual desde la consola de Firebase. Marca qué cuentas son del obrador.
//   orders/{id}             El cliente verificado crea pedidos a su teléfono y lee los suyos; el obrador lo gestiona todo.
//   customers/{telefono}    Expediente del cliente. Él crea su perfil (alta) y lo lee; ñapas y compras solo las escribe el obrador.
//   reviews/{uid_producto}  Público y anónimo. Solo clientes verificados por SMS con compra previa.
//   reviewAuthors/{id}      Privado. Vincula cada reseña con su teléfono (solo lo ve el obrador).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Utilidades ----------

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPhone(value) {
      return value is string && value.matches('^[+][0-9]{8,15}$');
    }

    function isQty(value) {
      return value is int && value >= 0 && value <= 200;
    }

    function isStars(value) {
      return value is int && value >= 1 && value <= 5;
    }

    // Teléfono verificado por SMS de la sesión ('' si no hay sesión o es una cuenta de email, como la del obrador)
    function verifiedPhone() {
      return signedIn() ? request.auth.token.get('phone_number', '') : '';
    }

    // Teléfonos ficticios de prueba (+34 600 000 000 a 006 y +34 600 023 456). Deben coincidir con TEST_PHONES de env.js.
    function isTestPhone(phone) {
      return isPhone(phone) && (phone.matches('^[+]3460000000[0-6]$') || phone == '+34600023456');
    }

    // Puede actuar en nombre de un teléfono: su dueño verificado por SMS, o cualquiera si es un teléfono de prueba
    // (sesiones de prueba sin SMS; sus datos son ficticios y no se muestran al público)
    function canActAs(phone) {
      return isPhone(phone) && (verifiedPhone() == phone || isTestPhone(phone));
    }

    // ---------- Pedidos ----------

    // Precios en céntimos: deben coincidir con shared.js (clásico 150, bocadillo 170, envío 100).
    function validNewOrder(d) {
      return d.keys().hasAll(['customerName', 'phone', 'items', 'subtotalCents', 'deliveryCents',
                              'totalCents', 'napaCount', 'deliveryMethod', 'address', 'deliverySlot',
                              'status', 'createdAt'])
        && d.keys().hasOnly(['customerName', 'phone', 'items', 'subtotalCents', 'deliveryCents',
                             'totalCents', 'napaCount', 'deliveryMethod', 'address', 'deliverySlot',
                             'status', 'createdAt', 'referralCode'])
        && d.customerName is string
        && d.customerName.size() >= 2 && d.customerName.size() <= 80
        && isPhone(d.phone)
        && d.items is map
        && d.items.keys().hasAll(['clasico', 'bocadillo'])
        && d.items.keys().hasOnly(['clasico', 'bocadillo'])
        && isQty(d.items.clasico)
        && isQty(d.items.bocadillo)
        && d.items.clasico + d.items.bocadillo > 0
        && d.deliveryMethod in ['recogida', 'domicilio']
        && d.deliveryCents == (d.deliveryMethod == 'domicilio' ? 100 : 0)
        && d.subtotalCents == d.items.clasico * 150 + d.items.bocadillo * 170
        && d.totalCents == d.subtotalCents + d.deliveryCents
        && d.napaCount == math.floor(d.totalCents / 1000)
        && d.address is string
        && (d.deliveryMethod == 'domicilio'
              ? (d.address.size() >= 5 && d.address.size() <= 200)
              : d.address == 'Recogida en local')
        && d.deliverySlot is string
        && d.deliverySlot.matches('^(0[6-9]|1[0-7]):(00|30)$')
        && (!('referralCode' in d) || (isPhone(d.referralCode) && d.referralCode != d.phone))
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Auth wall en el servidor: solo se pide a nombre del propio teléfono verificado
    match /orders/{orderId} {
      allow create: if validNewOrder(request.resource.data) && canActAs(request.resource.data.phone);
      allow read: if isAdmin() || canActAs(resource.data.phone);
      allow update, delete: if isAdmin();
    }

    // ---------- Clientes ----------

    // Perfil que crea el propio cliente en el alta (onboarding). El resto de campos
    // (napaCredits, completedOrders, purchased, referidos…) solo los escribe el obrador al entregar pedidos.
    function validProfile(d, phone) {
      return d.keys().hasAll(['name', 'phone', 'address', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'phone', 'address', 'referralCode', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.phone == phone
        && d.address is string && d.address.size() <= 200
        && (!('referralCode' in d) || (isPhone(d.referralCode) && d.referralCode != phone))
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /customers/{phone} {
      allow read, write: if isAdmin();
      allow get: if canActAs(phone);
      allow create: if canActAs(phone) && validProfile(request.resource.data, phone);
      // Expediente creado antes por el obrador: el cliente solo completa nombre y dirección
      allow update: if canActAs(phone)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.address is string && request.resource.data.address.size() <= 200
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- Reseñas ----------

    function hasPurchased(phone, product) {
      let path = /databases/$(database)/documents/customers/$(phone);
      return exists(path) && get(path).data.get('purchased', {}).get(product, 0) > 0;
    }

    // Teléfono del autor de una reseña de prueba, leído del documento reviewAuthors que se crea en el mismo lote
    function testAuthorPhone(reviewId) {
      return getAfter(/databases/$(database)/documents/reviewAuthors/$(reviewId)).data.phone;
    }

    function validReview(d) {
      return d.keys().hasAll(['product', 'ratings', 'comment', 'test', 'rewarded', 'createdAt'])
        && d.keys().hasOnly(['product', 'ratings', 'comment', 'test', 'rewarded', 'createdAt'])
        && d.test is bool
        && d.product in ['clasico', 'bocadillo']
        && d.ratings is map
        && d.ratings.keys().hasAll(['producto', 'entrega', 'atencion'])
        && d.ratings.keys().hasOnly(['producto', 'entrega', 'atencion'])
        && isStars(d.ratings.producto)
        && isStars(d.ratings.entrega)
        && isStars(d.ratings.atencion)
        && d.comment is string
        && d.comment.size() <= 500
        && d.rewarded == false
        && d.createdAt == request.time;
    }

    // Una reseña por cliente y producto: el id es "<uid>_<producto>" y solo se permite crearla, nunca sobrescribirla.
    // El documento público no guarda nombre ni teléfono. "test" es obligatorio y debe decir la verdad:
    // las cuentas de prueba no pueden publicar reseñas que parezcan de clientes reales.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && isPhone(verifiedPhone())
        && reviewId == request.auth.uid + '_' + request.resource.data.product
        && validReview(request.resource.data)
        && request.resource.data.test == isTestPhone(verifiedPhone())
        && hasPurchased(verifiedPhone(), request.resource.data.product)
        && existsAfter(/databases/$(database)/documents/reviewAuthors/$(reviewId));
      // Generador de datos de prueba del panel: solo ids "seed_*" y siempre marcadas como prueba
      allow create: if isAdmin()
        && reviewId.matches('^seed_.+')
        && validReview(request.resource.data)
        && request.resource.data.test == true
        && existsAfter(/databases/$(database)/documents/reviewAuthors/$(reviewId));
      // Sesión de prueba sin SMS (resenas.js): solo teléfonos de prueba con compra entregada,
      // id "test_<teléfono>_<producto>" (una por producto) y siempre marcada como prueba.
      // Como mucho existe una por teléfono de prueba y producto, y el público no las ve.
      allow create: if validReview(request.resource.data)
        && request.resource.data.test == true
        && isTestPhone(testAuthorPhone(reviewId))
        && reviewId == 'test_' + testAuthorPhone(reviewId) + '_' + request.resource.data.product
        && hasPurchased(testAuthorPhone(reviewId), request.resource.data.product);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewarded']);
      allow delete: if isAdmin();
    }

    match /reviewAuthors/{reviewId} {
      allow create: if signedIn()
        && isPhone(verifiedPhone())
        && request.resource.data.keys().hasAll(['uid', 'phone', 'product'])
        && request.resource.data.keys().hasOnly(['uid', 'phone', 'product'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phone == verifiedPhone()
        && reviewId == request.auth.uid + '_' + request.resource.data.product
        && existsAfter(/databases/$(database)/documents/reviews/$(reviewId));
      allow create: if isAdmin()
        && reviewId.matches('^seed_.+')
        && request.resource.data.keys().hasAll(['uid', 'phone', 'product'])
        && request.resource.data.keys().hasOnly(['uid', 'phone', 'product'])
        && isTestPhone(request.resource.data.phone)
        && existsAfter(/databases/$(database)/documents/reviews/$(reviewId));
      allow create: if request.resource.data.keys().hasAll(['uid', 'phone', 'product'])
        && request.resource.data.keys().hasOnly(['uid', 'phone', 'product'])
        && request.resource.data.uid == 'test'
        && isTestPhone(request.resource.data.phone)
        && reviewId == 'test_' + request.resource.data.phone + '_' + request.resource.data.product
        && existsAfter(/databases/$(database)/documents/reviews/$(reviewId));
      allow read, delete: if isAdmin();
    }
  }
}
