rules_version = '2';

// Reglas de seguridad de Pachoncito Pedidos.
// Despliegue: firebase deploy --only firestore:rules
//
// Identidad: cada cliente es su UID de Firebase (Google, o anónimo en el modo pruebas).
// El panel del obrador entra con email y contraseña y se reconoce por el documento admins/{uid}.
//
// Colecciones:
//   admins/{uid}             Alta manual desde la consola. Marca qué cuentas son del obrador.
//   customers/{uid}          Expediente del cliente. Él crea su alta y edita nombre/dirección;
//                            ñapas, compras y verificación del teléfono solo los escribe el obrador.
//   phoneClaims/{teléfono}   Cerrojo antifraude: un teléfono = una cuenta (y una cuenta = un teléfono).
//   referralCodes/{código}   Código de invitación de cada cliente → su UID.
//   orders/{id}              El cliente crea pedidos a su nombre y con su teléfono vinculado; lee los suyos.
//                            creditsToRedeem (opcional): ñapas acumuladas que elige canjear en ese pedido.
//   reviews/{idPedido}       Públicas y anónimas. Una por pedido entregado (el cliente elige qué sabor valora)
//                            y cada una da 1 ñapa. Las antiguas (uid_producto) y las de prueba (seed_*) se conservan.
//   reviewAuthors/{id}       Privado. Vincula cada reseña con su autor (solo lo ve el obrador).
//   customers/{teléfono}     Expedientes antiguos (antes de las cuentas de Google): solo el obrador.
//   ingredients/{id}         Materias primas: proveedor, precio, precio anterior y receta por tanda (solo el obrador).
//   settings/costs           Tamaño de tanda y otros costes (solo el obrador).
//   settings/store           { open } Obrador abierto o en descanso. Lo lee cualquiera; con open == false no se aceptan pedidos.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Utilidades ----------

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Sesión anónima del modo pruebas (?pruebas=1): todo lo que cree queda marcado como prueba
    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isPhone(value) {
      return value is string && value.matches('^[+][0-9]{8,15}$');
    }

    // Teléfonos ficticios de prueba. Deben coincidir con isTestPhone() de env.js.
    function isTestPhone(phone) {
      return isPhone(phone) && phone.matches('^[+]34600(000[0-9]{3}|023456)$');
    }

    function isReferralCode(value) {
      return value is string && value.matches('^[A-Z]{3}-[A-Z2-9]{4}$');
    }

    function isQty(value) {
      return value is int && value >= 0 && value <= 200;
    }

    function isStars(value) {
      return value is int && value >= 1 && value <= 5;
    }

    function customerPath(uid) {
      return /databases/$(database)/documents/customers/$(uid);
    }

    function claimPath(phone) {
      return /databases/$(database)/documents/phoneClaims/$(phone);
    }

    function codePath(code) {
      return /databases/$(database)/documents/referralCodes/$(code);
    }

    // Móvil español real (repite validateMobile() de shared.js): 6xx o 71x–74x, sin 5 cifras iguales
    // seguidas ni secuencias de 6 (123456 / 654321). Los demás campos con teléfono siguen usando isPhone().
    function isRealMobile(phone) {
      return isPhone(phone)
        && phone.matches('^[+]34(6[0-9]|7[1-4])[0-9]{7}$')
        && !phone.matches('.*(00000|11111|22222|33333|44444|55555|66666|77777|88888|99999).*')
        && !phone.matches('.*(012345|123456|234567|345678|456789|987654|876543|765432|654321|543210).*');
    }

    // Al vincular un teléfono: los clientes de prueba (anónimos) solo teléfonos de prueba; el resto, móviles reales
    function allowedPhone(phone) {
      return isAnonymous() ? isTestPhone(phone) : isRealMobile(phone);
    }

    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 80;
    }

    function validAddress(address) {
      return address is string && address.size() <= 200;
    }

    // ---------- Administradores ----------

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // ---------- Costes del obrador (privados: precios de proveedores y receta por tanda) ----------

    match /ingredients/{ingredientId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if settingId == 'store';
      allow read, write: if isAdmin();
    }

    // Obrador abierto (sin documento settings/store, o sin el campo, también cuenta como abierto)
    function storeOpen() {
      return !exists(/databases/$(database)/documents/settings/store)
        || get(/databases/$(database)/documents/settings/store).data.get('open', true) != false;
    }

    // ---------- Clientes ----------

    // Alta: perfil + phoneClaims + referralCodes en el MISMO lote (getAfter comprueba los tres).
    function validNewCustomer(d, uid) {
      return d.keys().hasAll(['name', 'email', 'phone', 'address', 'referralCode', 'test', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'email', 'phone', 'address', 'referralCode', 'referredByCode', 'test', 'createdAt', 'updatedAt'])
        && validName(d.name)
        && d.email == request.auth.token.get('email', '')
        && allowedPhone(d.phone)
        && validAddress(d.address)
        && isReferralCode(d.referralCode)
        && d.test == isAnonymous()
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && getAfter(claimPath(d.phone)).data.uid == uid
        && getAfter(codePath(d.referralCode)).data.uid == uid
        && (!('referredByCode' in d)
              || (isReferralCode(d.referredByCode)
                  && exists(codePath(d.referredByCode))
                  && get(codePath(d.referredByCode)).data.uid != uid));
    }

    // Edición de datos de contacto (nunca ñapas, compras ni teléfono)
    function isProfileEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'updatedAt'])
        && validName(request.resource.data.name)
        && validAddress(request.resource.data.address)
        && request.resource.data.updatedAt == request.time;
    }

    // Nueva vinculación tras que el obrador liberase su teléfono (phone == null)
    function isPhoneRelink(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'updatedAt'])
        && resource.data.get('phone', null) == null
        && allowedPhone(request.resource.data.phone)
        && getAfter(claimPath(request.resource.data.phone)).data.uid == uid
        && request.resource.data.updatedAt == request.time;
    }

    function reviewPath(id) {
      return /databases/$(database)/documents/reviews/$(id);
    }

    function orderPath(id) {
      return /databases/$(database)/documents/orders/$(id);
    }

    // Ñapa por valorar: 1 por cada pedido entregado que se valora. Exactamente +1 y solo junto a la reseña
    // nueva de ese pedido (reviews/{lastReviewedOrder}); como la reseña solo se crea una vez, no se repite.
    function isReviewReward(uid) {
      let orderId = request.resource.data.get('lastReviewedOrder', '');
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['napaCredits', 'lastReviewedOrder', 'updatedAt'])
        && orderId is string
        && orderId.size() > 0
        && request.resource.data.napaCredits == resource.data.get('napaCredits', 0) + 1
        && request.resource.data.updatedAt == request.time
        && !exists(reviewPath(orderId))
        && existsAfter(reviewPath(orderId))
        && getAfter(reviewPath(orderId)).data.rewarded == true;
    }

    match /customers/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validNewCustomer(request.resource.data, uid);
      allow update: if isOwner(uid) && (isProfileEdit() || isPhoneRelink(uid) || isReviewReward(uid));
      allow read, write: if isAdmin();
    }

    // ---------- Antifraude: un teléfono, una cuenta ----------

    // Se crea en el mismo lote que el alta (o la nueva vinculación) de la cuenta que lo reclama.
    // Como es "create" y no "update", si el teléfono ya está vinculado a otra cuenta el lote entero se rechaza.
    function validClaim(phone) {
      return allowedPhone(phone)
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(customerPath(request.auth.uid)).data.phone == phone
        && (!exists(customerPath(request.auth.uid))
              || get(customerPath(request.auth.uid)).data.get('phone', null) == null);
    }

    match /phoneClaims/{phone} {
      allow create: if signedIn() && validClaim(phone);
      // Las cuentas de prueba pueden reutilizar teléfonos de prueba ya usados por otras cuentas de prueba
      allow update: if isAnonymous() && isTestPhone(phone) && validClaim(phone);
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow read, write: if isAdmin(); // «Liberar teléfono» en el panel
    }

    // ---------- Códigos de invitación ----------

    match /referralCodes/{code} {
      // Para validar el código que escribe un cliente nuevo (solo revela un UID opaco)
      allow get: if signedIn();
      allow create: if signedIn()
        && isReferralCode(code)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(customerPath(request.auth.uid))
        && getAfter(customerPath(request.auth.uid)).data.referralCode == code;
      allow read, write: if isAdmin();
    }

    // ---------- Pedidos ----------

    // Precios en céntimos: deben coincidir con shared.js (clásico 150, bocadillo 170, envío 100).
    function validNewOrder(d) {
      return d.keys().hasAll(['uid', 'customerName', 'phone', 'items', 'subtotalCents', 'deliveryCents',
                              'totalCents', 'napaCount', 'deliveryMethod', 'address', 'deliverySlot',
                              'status', 'test', 'createdAt'])
        && d.keys().hasOnly(['uid', 'customerName', 'phone', 'items', 'subtotalCents', 'deliveryCents',
                             'totalCents', 'napaCount', 'deliveryMethod', 'address', 'deliverySlot',
                             'status', 'test', 'createdAt', 'creditsToRedeem'])
        && d.uid is string
        && validName(d.customerName)
        && isPhone(d.phone)
        && d.items is map
        && d.items.keys().hasAll(['clasico', 'bocadillo'])
        && d.items.keys().hasOnly(['clasico', 'bocadillo'])
        && isQty(d.items.clasico)
        && isQty(d.items.bocadillo)
        && d.items.clasico + d.items.bocadillo > 0
        && d.deliveryMethod in ['recogida', 'domicilio']
        && d.deliveryCents == (d.deliveryMethod == 'domicilio' ? 100 : 0)
        && d.subtotalCents == d.items.clasico * 150 + d.items.bocadillo * 170
        && d.totalCents == d.subtotalCents + d.deliveryCents
        && d.napaCount == math.floor(d.totalCents / 1000)
        && (!('creditsToRedeem' in d) || isQty(d.creditsToRedeem))
        && d.address is string
        && (d.deliveryMethod == 'domicilio'
              ? (d.address.size() >= 5 && d.address.size() <= 200)
              : d.address == 'Recogida en local')
        && d.deliverySlot is string
        && d.deliverySlot.matches('^(0[6-9]|1[0-7]):(00|30)$')
        && d.test is bool
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    match /orders/{orderId} {
      // Cliente: a su nombre y con SU teléfono vinculado (un teléfono liberado deja de valer)
      allow create: if signedIn()
        && validNewOrder(request.resource.data)
        && storeOpen()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.test == isAnonymous()
        && request.resource.data.phone == get(customerPath(request.auth.uid)).data.phone
        // Y ese teléfono tiene que ser un móvil español real (o de prueba en las cuentas de prueba)
        && allowedPhone(request.resource.data.phone)
        // Solo puede canjear las ñapas que tiene acumuladas (las no elegidas se le guardan)
        && request.resource.data.get('creditsToRedeem', 0) <= get(customerPath(request.auth.uid)).data.get('napaCredits', 0);
      // Generador de datos de prueba del panel
      allow create: if isAdmin()
        && validNewOrder(request.resource.data)
        && request.resource.data.test == true
        && request.resource.data.uid.matches('^seed_.+');
      allow read: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---------- Reseñas ----------

    function validReview(d) {
      return d.keys().hasAll(['product', 'ratings', 'comment', 'test', 'rewarded', 'createdAt'])
        && d.keys().hasOnly(['product', 'ratings', 'comment', 'test', 'rewarded', 'createdAt'])
        && d.test is bool
        && d.product in ['clasico', 'bocadillo']
        && d.ratings is map
        && d.ratings.keys().hasAll(['producto', 'entrega', 'atencion'])
        && d.ratings.keys().hasOnly(['producto', 'entrega', 'atencion'])
        && isStars(d.ratings.producto)
        && isStars(d.ratings.entrega)
        && isStars(d.ratings.atencion)
        && d.comment is string
        && d.comment.size() <= 500
        && d.rewarded is bool
        && d.createdAt == request.time;
    }

    // Pedido propio, entregado y que incluye el sabor valorado
    function reviewableOrder(orderId, product) {
      return exists(orderPath(orderId))
        && get(orderPath(orderId)).data.get('uid', '') == request.auth.uid
        && get(orderPath(orderId)).data.status == 'completed'
        && get(orderPath(orderId)).data.items.get(product, 0) > 0;
    }

    // Una reseña por pedido entregado: id = id del pedido, solo se crea y nunca se sobrescribe.
    // Siempre va con su ñapa (+1 al cliente en el mismo lote, ver isReviewReward).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && validReview(request.resource.data)
        && request.resource.data.test == isAnonymous()
        && request.resource.data.rewarded == true
        && reviewableOrder(reviewId, request.resource.data.product)
        && getAfter(customerPath(request.auth.uid)).data.get('napaCredits', 0)
             == get(customerPath(request.auth.uid)).data.get('napaCredits', 0) + 1
        && getAfter(customerPath(request.auth.uid)).data.get('lastReviewedOrder', '') == reviewId
        && existsAfter(/databases/$(database)/documents/reviewAuthors/$(reviewId));
      // Generador de datos de prueba del panel: clientes "seed_*", siempre marcadas como prueba
      allow create: if isAdmin()
        && reviewId.matches('^seed_.+')
        && validReview(request.resource.data)
        && request.resource.data.rewarded == false
        && request.resource.data.test == true
        && existsAfter(/databases/$(database)/documents/reviewAuthors/$(reviewId));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewarded']);
      allow delete: if isAdmin();
    }

    match /reviewAuthors/{reviewId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'product'])
        && request.resource.data.keys().hasOnly(['uid', 'product'])
        && request.resource.data.uid == request.auth.uid
        && reviewableOrder(reviewId, request.resource.data.product)
        && existsAfter(/databases/$(database)/documents/reviews/$(reviewId));
      allow create: if isAdmin()
        && reviewId.matches('^seed_.+')
        && request.resource.data.keys().hasAll(['uid', 'product'])
        && request.resource.data.keys().hasOnly(['uid', 'product'])
        && existsAfter(/databases/$(database)/documents/reviews/$(reviewId));
      allow read, delete: if isAdmin();
    }
  }
}
